#!/bin/bash

## Cores
amarelo="\e[33m"
verde="\e[32m"
branco="\e[97m"
vermelho="\e[91m"
reset="\e[0m"
SETUP_URL="${SETUP_URL:-https://raw.githubusercontent.com/flouds-dncarbonell/installer-flouds/main/Setup}"
INSTALLER_URL="${INSTALLER_URL:-https://raw.githubusercontent.com/flouds-dncarbonell/installer-flouds/main/SetupFlouds}"

falhar() {
    echo -e "$vermelho  ✖ $*$reset" >&2
    exit 1
}

detectar_sistema() {
    [ -r /etc/os-release ] || falhar "Não foi possível identificar o sistema operacional."
    # shellcheck disable=SC1091
    . /etc/os-release

    case "${ID:-}" in
        ubuntu|debian)
            gerenciador_pacotes="apt"
            pacotes=(ca-certificates curl git jq)
            ;;
        rhel|centos|rocky|almalinux|fedora)
            if command -v dnf >/dev/null 2>&1; then
                gerenciador_pacotes="dnf"
            else
                gerenciador_pacotes="yum"
            fi
            pacotes=(ca-certificates curl git jq)
            ;;
        *)
            falhar "Sistema ${PRETTY_NAME:-${ID:-desconhecido}} não suportado. Use Ubuntu, Debian, RHEL, Rocky, AlmaLinux, CentOS ou Fedora."
            ;;
    esac

    echo -e "$verde  ✔ Sistema detectado: ${PRETTY_NAME:-$ID}$reset"
}

## VPS recém-criada normalmente está rodando unattended-upgrades/cloud-init,
## que seguram o lock do dpkg por alguns minutos. Espera em vez de falhar.
apt_lock_ocupado() {
    local arquivo
    command -v fuser >/dev/null 2>&1 || return 1
    for arquivo in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock \
                   /var/lib/apt/lists/lock /var/cache/apt/archives/lock; do
        [ -e "$arquivo" ] || continue
        fuser "$arquivo" >/dev/null 2>&1 && return 0
    done
    return 1
}

aguardar_apt_lock() {
    local limite=${1:-600} esperado=0 avisou=0

    while apt_lock_ocupado; do
        if [ "$avisou" -eq 0 ]; then
            echo -e "$amarelo  O sistema está aplicando atualizações automáticas.$reset"
            echo -e "$amarelo  Aguardando a liberação do apt, isso pode levar alguns minutos...$reset"
            avisou=1
        fi

        if [ "$esperado" -ge "$limite" ]; then
            falhar "O apt segue bloqueado após ${limite}s. Aguarde o fim das atualizações automáticas do sistema e execute o instalador novamente."
        fi

        sleep 5
        esperado=$((esperado + 5))
    done

    [ "$avisou" -eq 1 ] && echo -e "$verde  ✔ apt liberado$reset"
    return 0
}

## Roda apt-get tolerando lock ocupado; erros reais aparecem na tela.
apt_get() {
    local tentativa=1 max=10 saida

    while :; do
        aguardar_apt_lock

        if saida="$(apt-get -o DPkg::Lock::Timeout=60 -y "$@" 2>&1)"; then
            return 0
        fi

        if grep -qiE 'dpkg (was|foi) interrup|dpkg --configure -a' <<<"$saida"; then
            dpkg --configure -a >/dev/null 2>&1 || true
            continue
        fi

        if ! grep -qiE 'could not get lock|unable to acquire|frontend lock|temporarily unavailable|recurso temporariamente' <<<"$saida"; then
            printf '%s\n' "$saida" >&2
            return 1
        fi

        if [ "$tentativa" -ge "$max" ]; then
            printf '%s\n' "$saida" >&2
            return 1
        fi

        tentativa=$((tentativa + 1))
        sleep 5
    done
}

instalar_dependencias() {
    echo -e "$amarelo[1/3]$reset Atualizando o índice de pacotes..."
    case "$gerenciador_pacotes" in
        apt)
            export DEBIAN_FRONTEND=noninteractive
            apt_get update || falhar "Falha ao atualizar o índice do apt."
            apt_get install "${pacotes[@]}" || falhar "Falha ao instalar as dependências."
            ;;
        dnf)
            dnf -y makecache >/dev/null || falhar "Falha ao atualizar o índice do dnf."
            dnf -y install "${pacotes[@]}" >/dev/null || falhar "Falha ao instalar as dependências."
            ;;
        yum)
            yum -y makecache >/dev/null || falhar "Falha ao atualizar o índice do yum."
            yum -y install "${pacotes[@]}" >/dev/null || falhar "Falha ao instalar as dependências."
            ;;
    esac
    echo -e "$verde  ✔ Dependências instaladas$reset"
}

## IP que o Swarm deve anunciar. Numa VPS com mais de um endereço o Docker
## se recusa a escolher sozinho, e é essa a falha mais comum do swarm init.
ip_para_anunciar() {
    local ip
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null \
        | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    [ -n "$ip" ] || ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "$ip"
}

## Inicia o Swarm mostrando o motivo real quando falha. A segunda tentativa
## informa explicitamente o IP a anunciar; a terceira usa o loopback, que é o
## suficiente para um nó único (inclusive numa instalação local).
iniciar_swarm() {
    local saida ip

    if saida=$(docker swarm init 2>&1); then
        return 0
    fi

    ## Um estado "pending" ou "locked" não se resolve repetindo o init.
    case "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" in
        active) return 0 ;;
        pending|locked)
            printf '%s\n' "$saida" >&2
            echo -e "$amarelo O Docker Swarm ficou em estado inconsistente. Execute$reset" >&2
            echo -e "$amarelo   docker swarm leave --force$reset" >&2
            echo -e "$amarelo e rode o instalador novamente.$reset" >&2
            return 1
            ;;
    esac

    ip=$(ip_para_anunciar)
    if [ -n "$ip" ]; then
        echo -e "$amarelo Tentando novamente anunciando o IP $ip...$reset"
        if saida=$(docker swarm init --advertise-addr "$ip" 2>&1); then
            return 0
        fi
    fi

    echo -e "$amarelo Tentando novamente em modo local (127.0.0.1)...$reset"
    if docker swarm init --advertise-addr 127.0.0.1 >/dev/null 2>&1; then
        return 0
    fi

    printf '%s\n' "$saida" >&2
    return 1
}

## Bootstrap carregado via curl; não redirecionar stdin aqui.

clear
echo ""
echo -e "$amarelo====================================================================================================$reset"
echo -e "$amarelo=                                                                                                  =$reset"
echo -e "$amarelo=                    $branco███████╗██╗      ██████╗ ██╗   ██╗██████╗ ███████╗$amarelo                    =$reset"
echo -e "$amarelo=                    $branco██╔════╝██║     ██╔═══██╗██║   ██║██╔══██╗██╔════╝$amarelo                    =$reset"
echo -e "$amarelo=                    $branco█████╗  ██║     ██║   ██║██║   ██║██║  ██║███████╗$amarelo                    =$reset"
echo -e "$amarelo=                    $branco██╔══╝  ██║     ██║   ██║██║   ██║██║  ██║╚════██║$amarelo                    =$reset"
echo -e "$amarelo=                    $branco██║     ███████╗╚██████╔╝╚██████╔╝██████╔╝███████║$amarelo                    =$reset"
echo -e "$amarelo=                    $branco╚═╝     ╚══════╝ ╚═════╝  ╚═════╝ ╚═════╝ ╚══════╝$amarelo                    =$reset"
echo -e "$amarelo=                                                                                                  =$reset"
echo -e "$amarelo====================================================================================================$reset"
echo ""
echo -e "$branco Aguarde enquanto preparamos o ambiente...$reset"
echo ""
sleep 1

## Verifica root
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo &>/dev/null; then
        echo -e "$amarelo Reexecutando com sudo...$reset"
        tmp_script="$(mktemp)"
        curl -fsSL "$SETUP_URL" -o "$tmp_script" || {
            echo -e "$vermelho Erro ao baixar o instalador para executar com sudo.$reset"
            exit 1
        }
        exec sudo bash "$tmp_script" "$@"
    fi
    echo -e "$vermelho Este script precisa ser executado como root.$reset"
    exit 1
fi

## Garante estar em /root
cd /root || exit 1

detectar_sistema
instalar_dependencias

## Instala Docker se não existir
echo -e "$amarelo[2/3]$reset Verificando Docker..."
if ! command -v docker &> /dev/null; then
    echo -e "       Instalando Docker..."
    curl -fsSL https://get.docker.com | sh > /dev/null 2>&1 || falhar "Falha ao instalar Docker."
    echo -e "$verde  ✔ Docker instalado$reset"
else
    echo -e "$verde  ✔ Docker já instalado$reset"
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now docker >/dev/null 2>&1 || falhar "Falha ao iniciar o serviço Docker."
fi
docker version >/dev/null 2>&1 || falhar "Docker foi instalado, mas o daemon não está respondendo."

echo ""

## Verifica/inicia Swarm
echo -e "$amarelo[3/3]$reset Verificando Docker Swarm..."
SWARM_STATUS=$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)
if [ "$SWARM_STATUS" != "active" ]; then
    echo -e "$amarelo Iniciando Docker Swarm...$reset"
    iniciar_swarm || falhar "Falha ao iniciar Docker Swarm."
    echo -e "$verde  ✔ Swarm iniciado$reset"
else
    echo -e "$verde  ✔ Docker Swarm já está ativo$reset"
fi

echo ""
echo -e "$verde Ambiente pronto! Iniciando o instalador Flouds...$reset"
echo ""
sleep 2

## Baixa de forma atômica para não deixar um instalador parcial em caso de falha
tmp_installer=$(mktemp)
if curl -fsSL "$INSTALLER_URL" -o "$tmp_installer"; then
    chmod +x "$tmp_installer"
    mv -f "$tmp_installer" SetupFlouds
    ./SetupFlouds "$@"
else
    rm -f "$tmp_installer"
    echo -e "$vermelho Erro ao baixar o instalador. Verifique sua conexão.$reset"
    exit 1
fi
