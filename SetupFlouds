## Coleta estado dos serviços para o suporte. Não inclui variáveis de ambiente
## nem o conteúdo dos arquivos de credenciais.
salvar_diagnostico() {
    local destino="${home_directory}/dados_vps/diagnostico_$(date '+%Y%m%d_%H%M%S').txt"
    local servico

    {
        echo "== Instalador =="
        echo "versao: $versao"
        echo "data: $(date '+%Y-%m-%d %H:%M:%S')"
        echo ""
        echo "== Estado =="
        ## A chave de licença é do cliente e não tem utilidade para o suporte:
        ## fica fora do arquivo que sai deste servidor.
        grep -v "^Licenca:" "$estado_file" 2>/dev/null
        echo ""
        echo "== Serviços =="
        docker service ls 2>&1
        echo ""
        for servico in postgres fzap traefik portainer; do
            echo "== Tarefas da stack $servico =="
            docker stack ps "$servico" --no-trunc 2>&1 | head -20
            echo ""
        done
        echo "== Log do instalador =="
        tail -200 "$log_file" 2>/dev/null
    } > "$destino" 2>/dev/null

    chmod 600 "$destino" 2>/dev/null

    echo ""
    item_ok "Diagnóstico salvo em $destino"
    echo ""
    echo -e "$bege O arquivo contém o estado dos serviços e o log do instalador.$reset"
    echo -e "$bege Ele não contém senhas nem tokens.$reset"
