## INÍCIO
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Verifica root
if [ "$(id -u)" -ne 0 ]; then
    echo -e "$vermelho Este script precisa ser executado como root.$reset"
    exit 1
fi

cd /root || exit 1

## Tela de boas-vindas
nome_instalador

linha_fina
echo -e "$branco Instale o FZAP e deixe-o acessível com HTTPS.$reset"
echo -e "$bege O instalador prepara automaticamente tudo o que for necessário:$reset"
echo -e "$bege endereços, certificado, banco de dados e painel técnico.$reset"
linha_fina
echo ""
ler_entrada -p " Pressione ENTER para continuar..."

if [ "$modo_infra" = true ]; then
    ferramenta_traefik_e_portainer
    exit 0
fi

## Loop principal
while true; do

    menu_instalador

    if ! ler_entrada -p " Escolha: " opcao; then
        echo ""
        echo -e "$vermelho Não foi possível ler a opção. Execute o instalador em um terminal interativo.$reset"
        exit 1
    fi

    case $opcao in

        1|fzap|FZAP)
            jornada_instalar_fzap
            ;;

        2|avancado|avançado|traefik|portainer)
            ferramenta_traefik_e_portainer
            ;;

        3|manutencao|manutenção)
            estado_restaurar_dados
            menu_manutencao
            ;;

        0|sair|exit)
            nome_finalizado
            echo -e "$branco Até mais!$reset"
            echo ""
            exit 0
            ;;

        *)
            ## Uma opção digitada errado é recuperável: repete o menu na volta
            ## seguinte, sem tela de erro e sem pausa fixa.
            ;;
    esac

done
