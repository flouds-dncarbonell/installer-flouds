## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## MANUTENÇÃO E REENTRADA
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Uma instalação que escolheu "configurar o DNS depois" pode ter esgotado as
## tentativas de emissão do certificado. Reiniciar o Traefik força uma nova
## rodada sem esperar o backoff.
reemitir_certificado() {
    clear
    echo ""
    echo -e "$branco Emitir o certificado HTTPS novamente$reset"
    linha_fina
    echo ""

    if [ "$modo_local" = true ]; then
        item_falha "Esta é uma instalação local: ela não usa HTTPS."
        echo ""
        ler_entrada -p " Pressione ENTER para voltar..."
        return 1
    fi

    if ! docker service ls --format "{{.Name}}" 2>/dev/null | grep -q "^traefik_traefik$"; then
        item_falha "O componente de HTTPS não está instalado neste servidor."
        echo ""
        ler_entrada -p " Pressione ENTER para voltar..."
        return 1
    fi

    echo -e "$bege A Let's Encrypt limita o número de tentativas por domínio. Só use$reset"
    echo -e "$bege esta opção depois de confirmar que o DNS já aponta para cá.$reset"
    echo ""

    executar_passo "Reiniciando o componente de HTTPS" \
        docker service update --force traefik_traefik || return 1
    executar_passo "Aguardando o componente subir" wait_stack traefik || return 1

    if [ -n "$url_fzap" ] && certificado_valido "$url_fzap"; then
        item_ok "Certificado válido para $url_fzap"
    else
        item_atencao "O certificado ainda não está válido. Aguarde alguns minutos."
    fi
    echo ""
    ler_entrada -p " Pressione ENTER para voltar..."
}

