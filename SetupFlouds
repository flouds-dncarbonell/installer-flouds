}

obter_token_api_portainer() {
    local token_salvo
    local jwt
    local usuario_atual
    local usuario_id
    local resposta_token

    PORTAINER_URL=$(ler_campo_arquivo "$dados_portainer_file" "Dominio do portainer: ")
    USUARIO=$(ler_campo_arquivo "$dados_portainer_file" "Usuario: ")
    SENHA=$(ler_campo_arquivo "$dados_portainer_file" "Senha: ")
    token_salvo=$(ler_campo_arquivo "$dados_portainer_file" "Token API: ")
    [ -n "$token_salvo" ] || token_salvo=$(ler_campo_arquivo "$dados_portainer_file" "Token: ")

    preparar_acesso_portainer "$PORTAINER_URL" || true

    ## Um token válido é reaproveitado: nenhuma execução cria um segundo token.
    if [ -n "$token_salvo" ] && portainer_api -fsS \
        -H "X-API-Key: $token_salvo" \
        "$(painel_api_base "$PORTAINER_URL")/api/users/me" \
        | jq -e '.Id | numbers' >/dev/null 2>&1; then
        PORTAINER_API_KEY="$token_salvo"
        log_tecnico "token de automação existente reaproveitado"
        return 0
    fi

    jwt=$(portainer_api -fsS -X POST \
        -H "Content-Type: application/json" \
        --data "$(jq -n --arg usuario "$USUARIO" --arg senha "$SENHA" \
            '{username: $usuario, password: $senha}')" \
        "$(painel_api_base "$PORTAINER_URL")/api/auth" \
        | jq -r '.jwt // empty' 2>/dev/null) || true

    if [ -z "$jwt" ]; then
        echo -e "$vermelho  ✖ Não foi possível autenticar no painel técnico.$reset"
        echo -e "$bege    Verifique o endereço, o usuário e a senha do Portainer.$reset"
        return 1
    fi

    usuario_atual=$(portainer_api -fsS \
        -H "Authorization: Bearer $jwt" \
        "$(painel_api_base "$PORTAINER_URL")/api/users/me" 2>/dev/null) || true
    usuario_id=$(echo "$usuario_atual" | jq -r '.Id // empty' 2>/dev/null)
    if [ -z "$usuario_id" ]; then
        echo -e "$vermelho  ✖ Não foi possível identificar o usuário do painel técnico.$reset"
        return 1
    fi

    resposta_token=$(portainer_api -fsS -X POST \
        -H "Authorization: Bearer $jwt" \
        -H "Content-Type: application/json" \
        --data "$(jq -n --arg descricao "FZAP Installer" --arg senha "$SENHA" \
            '{description: $descricao, password: $senha}')" \
        "$(painel_api_base "$PORTAINER_URL")/api/users/$usuario_id/tokens" 2>/dev/null) || true
    jwt=""

    PORTAINER_API_KEY=$(echo "$resposta_token" \
        | jq -r '.rawAPIKey // .RawAPIKey // empty' 2>/dev/null)
    if [ -z "$PORTAINER_API_KEY" ]; then
        echo -e "$vermelho  ✖ Não foi possível criar o token de automação do Portainer.$reset"
        return 1
    fi

    if grep -q "^Token API:" "$dados_portainer_file"; then
        atualizar_campo_arquivo "$dados_portainer_file" "Token API: " "$PORTAINER_API_KEY"
    elif grep -q "^Token:" "$dados_portainer_file"; then
        sed -i 's/^Token:/Token API:/' "$dados_portainer_file"
        atualizar_campo_arquivo "$dados_portainer_file" "Token API: " "$PORTAINER_API_KEY"
    else
        atualizar_campo_arquivo "$dados_portainer_file" "Token API: " "$PORTAINER_API_KEY"
    fi

    return 0
}

## Deploy da stack via API do Portainer
## Instala ou atualiza uma stack pela API do Portainer. Uma stack já existente é
## atualizada (PUT), nunca recriada: é isso que permite retomar uma instalação
## interrompida sem duplicar recursos.
deploy() {
    local STACK_NAME="$1"
    local stack_id
    local response_output http_code response_body detalhe

    ## Compatibilidade: instalações antigas gravavam o domínio com o protocolo.
    sed -i 's|Dominio do portainer: https://||' "$dados_portainer_file" 2>/dev/null

    obter_token_api_portainer || return 1

    ENDPOINT_ID=$(portainer_api -s -X GET \
        -H "X-API-Key: $PORTAINER_API_KEY" \
        "$(painel_api_base "$PORTAINER_URL")/api/endpoints" \
        | jq -r '.[] | select(.Name == "primary") | .Id' 2>/dev/null)
    if [ -z "$ENDPOINT_ID" ]; then
        item_falha "Não foi possível falar com o painel técnico."
        log_tecnico "endpoint 'primary' não encontrado na API do Portainer"
        return 1
    fi
    log_tecnico "endpoint primary=$ENDPOINT_ID"

    SWARM_ID=$(portainer_api -s -X GET \
        -H "X-API-Key: $PORTAINER_API_KEY" \
        "$(painel_api_base "$PORTAINER_URL")/api/endpoints/$ENDPOINT_ID/docker/swarm" \
        | jq -r .ID 2>/dev/null)
    log_tecnico "swarm id obtido para o endpoint $ENDPOINT_ID"

    if [ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" != "active" ]; then
        item_falha "O modo cluster do Docker não está ativo."
        log_tecnico "docker swarm inativo no momento do deploy de $STACK_NAME"
        return 1
    fi

    stack_id=$(portainer_api -s -X GET \
        -H "X-API-Key: $PORTAINER_API_KEY" \
        "$(painel_api_base "$PORTAINER_URL")/api/stacks" \
        | jq -r --arg nome "$STACK_NAME" \
            '.[] | select(.Name == $nome) | .Id' 2>/dev/null | head -1)

    response_output=$(mktemp)

    if [ -n "$stack_id" ]; then
        log_tecnico "stack $STACK_NAME já existe (id=$stack_id): atualizando via PUT"
        http_code=$(portainer_api -s -o "$response_output" -w "%{http_code}" -X PUT \
            -H "X-API-Key: $PORTAINER_API_KEY" \
            -H "Content-Type: application/json" \
            --data "$(jq -n --rawfile conteudo "${STACK_NAME}.yaml" \
                '{StackFileContent: $conteudo, Env: [], Prune: true}')" \
            "$(painel_api_base "$PORTAINER_URL")/api/stacks/$stack_id?endpointId=$ENDPOINT_ID" 2>/dev/null)
    else
        log_tecnico "stack $STACK_NAME não existe: criando via POST"
        http_code=$(portainer_api -s -o "$response_output" -w "%{http_code}" -X POST \
            -H "X-API-Key: $PORTAINER_API_KEY" \
            -F "Name=$STACK_NAME" \
            -F "file=@$(pwd)/${STACK_NAME}.yaml" \
            -F "SwarmID=$SWARM_ID" \
            -F "endpointId=$ENDPOINT_ID" \
            "$(painel_api_base "$PORTAINER_URL")/api/stacks/create/swarm/file" 2>/dev/null)
    fi

    response_body=$(cat "$response_output")
    rm -f "$response_output"

    if [ "$http_code" = "200" ] && echo "$response_body" | grep -q '"Id"'; then
        log_tecnico "stack $STACK_NAME aplicada com sucesso (HTTP $http_code)"
        return 0
    fi

    detalhe=$(echo "$response_body" | jq -r '.message // .details // empty' 2>/dev/null)
    log_tecnico "falha ao aplicar a stack $STACK_NAME (HTTP $http_code): ${detalhe:-sem detalhe}"
    item_falha "Não foi possível instalar o componente ${STACK_NAME}."
    return 1
}

requisitar_outra_instalacao() {
    echo ""
    echo -e "$amarelo====================================================================================================$reset"
