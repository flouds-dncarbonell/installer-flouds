                echo ""
                ler_entrada -p " Escolha: " escolha
                case "$escolha" in
                    1) etapa2_enderecos true || return 1 ;;
                    2) titulo_etapa 3 "Configurar o FZAP"; perguntar_email ;;
                    3) titulo_etapa 3 "Configurar o FZAP"; perguntar_idioma ;;
                    4) titulo_etapa 3 "Configurar o FZAP"; perguntar_licenca; perguntar_chatwoot ;;
                    *) ;;
                esac
                ;;
            0) return 1 ;;
            *) ;;
        esac
    done
}

