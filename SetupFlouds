verificar_infraestrutura_existente() {
    local tem_portainer=false
    local tem_traefik=false

    _tem_portainer && tem_portainer=true
    _tem_traefik && tem_traefik=true

    if $tem_portainer && $tem_traefik; then
        clear
        nome_traefik_portainer
        echo ""
        echo -e "$amarelo Atenção: Traefik e Portainer já detectados neste servidor.$reset"
        echo ""
        echo -e " $amarelo[1]$reset Reaproveitar infraestrutura existente"
        echo -e " $amarelo[2]$reset Reinstalar do zero"
        echo -e " $amarelo[3]$reset Reiniciar Portainer"
        echo ""
        ler_entrada -p " Escolha: " escolha
        case "$escolha" in
            1) _usar_existentes; return 1 ;;
            2) return 0 ;;
            3) reiniciar_portainer; return 1 ;;
            *) return 1 ;;
        esac

    elif $tem_portainer && ! $tem_traefik; then
        clear
        nome_traefik_portainer
        echo ""
        echo -e "$amarelo Atenção: Portainer detectado, mas Traefik não encontrado.$reset"
        echo ""
        echo -e " $amarelo[1]$reset Instalar apenas o Traefik"
        echo -e " $amarelo[2]$reset Reinstalar tudo do zero (remova o Portainer manualmente antes)"
        echo -e " $amarelo[3]$reset Reiniciar Portainer"
        echo ""
        ler_entrada -p " Escolha: " escolha
        case "$escolha" in
            1) _instalar_apenas_traefik; return 1 ;;
            2) return 0 ;;
            3) reiniciar_portainer; return 1 ;;
            *) return 1 ;;
        esac

    elif ! $tem_portainer && $tem_traefik; then
        clear
        nome_traefik_portainer
        echo ""
        echo -e "$amarelo Atenção: Traefik detectado, mas Portainer não encontrado.$reset"
        echo ""
        echo -e " $amarelo[1]$reset Instalar apenas o Portainer"
        echo -e " $amarelo[2]$reset Reinstalar tudo do zero (remova o Traefik manualmente antes)"
        echo ""
        ler_entrada -p " Escolha: " escolha
        case "$escolha" in
            1) _instalar_apenas_portainer; return 1 ;;
            2) return 0 ;;
            *) return 1 ;;
        esac
    fi

    return 0
}

