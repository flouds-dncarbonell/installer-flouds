    fi

    echo -e "$bege Isso leva de 2 a 5 minutos. Detalhes técnicos em$reset"
    echo -e "$bege $log_file$reset"
    echo ""

    preparar_infraestrutura
    resultado=$?
    if [ "$resultado" -eq 2 ]; then
        echo ""
        item_atencao "A infraestrutura deste servidor existe, mas sem credenciais registradas."
        echo ""
        echo -e "$bege Abra as configurações avançadas e escolha reaproveitar a$reset"
        echo -e "$bege infraestrutura para registrar os dados de acesso.$reset"
        echo ""
        ler_entrada -p " Pressione ENTER para voltar ao menu..."
        return 1
    fi
    [ "$resultado" -eq 0 ] || return 1

    estado_gravar "infra_pronta"

