## Oferece retomada quando a execução anterior parou no meio.
tela_retomar() {
    local escolha
    local etapa

    etapa=$(estado_ler "Etapa concluida")
    [ -n "$etapa" ] || return 0
    ## "falhou" também é uma execução interrompida: é exatamente o caso em que
    ## a tela de falha prometeu que o instalador retomaria de onde parou.
    case "$(estado_ler "Situacao")" in
        em_andamento|falhou) ;;
        *) return 0 ;;
    esac

    clear
    echo ""
    echo -e "$branco Encontramos uma instalação interrompida$reset"
    linha_fina
    echo ""
    case "$etapa" in
        verificado_servidor) echo -e " Ela parou depois de verificar o servidor." ;;
        dns_ok)              echo -e " Ela parou depois de configurar os endereços." ;;
        dados_confirmados)   echo -e " Ela parou antes de preparar o servidor." ;;
        infra_pronta)        echo -e " Ela parou depois de preparar o servidor." ;;
        postgres_saudavel)   echo -e " Ela parou depois de iniciar o banco de dados." ;;
        fzap_saudavel)       echo -e " Ela parou antes da verificação final." ;;
        *)                   echo -e " Ela parou na etapa \"$etapa\"." ;;
    esac
    echo ""
    echo -e "$bege Nada foi apagado. Retomar reaproveita o que já está pronto.$reset"
    echo ""

    linha_fina
    echo -e " $amarelo[1]$reset Continuar de onde parou — recomendado"
    echo -e " $amarelo[2]$reset Começar a verificação novamente"
    echo -e " $amarelo[3]$reset Abrir opções de manutenção"
    echo -e " $amarelo[0]$reset Voltar"
    echo ""
    ler_entrada -p " Escolha: " escolha

    case "$escolha" in
        1) estado_restaurar_dados; retomando=true; return 0 ;;
        2) estado_limpar; return 0 ;;
        3) menu_manutencao; return 1 ;;
        0) return 1 ;;
        *) return 1 ;;
    esac
}

## Menu de falha compartilhado pelas duas situações em que a instalação não
## chega ao fim. Devolve 0 quando o usuário quer tentar novamente.
tratar_falha() {
    estado_gravar "$(estado_ler "Etapa concluida")" "falhou"

    while true; do
        tela_falha_instalacao
        case "$escolha_falha" in
            1) return 0 ;;
            2) mostrar_motivo_tecnico ;;
            3) salvar_diagnostico ;;
            0|*) return 1 ;;
        esac
    done
}

jornada_instalar_fzap() {
    local resultado
    local escolha

    dominio_base=""
    url_fzap=""
    url_portainer=""
    email_ssl=""
    fzap_language=""
    licence_key=""
    senha_postgres=""
    admin_token=""
    retomando=false

    dados
    [ -n "$nome_rede_interna" ] || nome_rede_interna="$rede_padrao"
    validar_rede_docker "$nome_rede_interna" >/dev/null 2>&1 || nome_rede_interna="$rede_padrao"

    rotacionar_log
    log_tecnico "instalador $versao iniciado (verbose=$modo_verbose)"

    ## Uma instalação concluída não é tratada como erro.
    if [ "$(estado_ler "Situacao")" = "concluido" ] || stack_saudavel "fzap"; then
        tela_ja_instalado
        return 0
    fi

    tela_retomar || return 0

    if [ "$retomando" != true ]; then
        etapa1_verificar_servidor || return 0
        etapa2_enderecos || return 0
        etapa3_configurar || return 0
    else
        ## Na retomada, revalida o que depende do mundo externo e mantém o resto.
        estado_alcancou "dns_ok" || { etapa2_enderecos || return 0; }
        estado_alcancou "dados_confirmados" || { etapa3_configurar || return 0; }
        [ -n "$email_ssl" ] || { titulo_etapa 3 "Configurar o FZAP"; perguntar_email; }
        [ -n "$fzap_language" ] || fzap_language="pt-BR"
    fi

    ## Instalar e verificar ficam no mesmo laço: "tentar novamente" repete o
    ## trabalho sem pedir nenhum dado de novo, porque as respostas continuam em
    ## memória e cada etapa é idempotente.
    while true; do
        if ! etapa4_instalar; then
            tratar_falha && continue
            return 0
        fi

        etapa5_verificar
        resultado=$?

        if [ "$resultado" -eq 0 ]; then
            estado_gravar "concluido" "concluido"
            tela_conclusao_sucesso
            return 0
        fi

        if [ "$resultado" -eq 2 ]; then
            tratar_falha && continue
            return 0
        fi

        ## Serviços no ar, endereço ainda não disponível.
        estado_gravar "fzap_saudavel" "concluido"
        while true; do
            tela_conclusao_parcial
            ler_entrada -p " Escolha: " escolha
            case "$escolha" in
                1)
                    if etapa5_verificar; then
                        estado_gravar "concluido" "concluido"
                        tela_conclusao_sucesso
                        return 0
                    fi
                    ler_entrada -p " Pressione ENTER para voltar..."
                    ;;
                0|*) return 0 ;;
            esac
        done
    done
}

## Cabeçalho curto do menu. A arte grande aparece apenas na abertura e na
## conclusão, para não empurrar o conteúdo fora da tela a cada volta.
menu_instalador() {
    clear
    echo ""
    echo -e "$branco Flouds Installer$reset$bege   v$versao$reset"
    linha_fina
    echo ""
    echo -e " $amarelo[1]$reset Instalar o FZAP neste servidor — recomendado"
    echo -e " $amarelo[2]$reset Configurações avançadas"
    echo -e " $amarelo[3]$reset Manutenção e diagnóstico"
    echo ""
    echo -e " $amarelo[0]$reset Sair"
    echo ""
}

