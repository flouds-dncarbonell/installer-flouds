## LOG TÉCNICO
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Registra uma linha no log técnico. Em --verbose a linha também vai para a
## tela. Segredos nunca são passados para esta função.
log_tecnico() {
    local mensagem="$1"

    mkdir -p "$(dirname "$log_file")" 2>/dev/null
    printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$mensagem" >> "$log_file" 2>/dev/null
    chmod 600 "$log_file" 2>/dev/null

    if [ "$modo_verbose" = true ]; then
        echo -e "$bege    · $mensagem$reset"
    fi
}

## Mantém no máximo 5 execuções no histórico. A rotação é por execução e não
## por dia: o que interessa para o suporte é o log da instalação que falhou.
rotacionar_log() {
    local i

    [ -f "$log_file" ] || return 0

    for i in 4 3 2 1; do
        [ -f "${log_file}.$i" ] && mv -f "${log_file}.$i" "${log_file}.$((i + 1))" 2>/dev/null
    done
    mv -f "$log_file" "${log_file}.1" 2>/dev/null
    return 0
}

