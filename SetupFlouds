## Alinha rótulo e valor em colunas. Usa ${#texto}, que conta caracteres, e não
## printf %-Ns, que conta bytes e desalinharia rótulos acentuados.
rotulo_valor() {
    local rotulo="$1"
    local valor="$2"
    local largura=24
    local faltam
    local espacos=""

    faltam=$((largura - ${#rotulo}))
    [ "$faltam" -gt 0 ] && espacos=$(printf '%*s' "$faltam" '')
    echo "${rotulo}${espacos}${valor}"
}

