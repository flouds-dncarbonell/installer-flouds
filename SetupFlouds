    docker volume create fzap_logos >/dev/null 2>&1
    return 0
}

## Lê uma variável de ambiente de um serviço já em execução. É por aqui que uma
## retomada recupera os segredos gerados na execução anterior.
recuperar_env_do_servico() {
    local servico="$1"
    local variavel="$2"

    docker service inspect "$servico" \
        --format '{{range .Spec.TaskTemplate.ContainerSpec.Env}}{{println .}}{{end}}' 2>/dev/null \
        | awk -F= -v v="$variavel" '$1 == v { print substr($0, index($0, "=") + 1); exit }'
}

## Lê a mesma variável do arquivo da stack, quando o serviço não está de pé.
recuperar_env_do_arquivo() {
    local arquivo="$1"
    local variavel="$2"

    [ -f "$arquivo" ] || return 0
    awk -v v="$variavel" '
        {
            linha = $0
            sub(/^[[:space:]]*-[[:space:]]*/, "", linha)
            sub(/^"/, "", linha)
            sub(/"$/, "", linha)
            if (index(linha, v "=") == 1) {
                print substr(linha, length(v) + 2)
                exit
            }
        }
    ' "$arquivo"
}

## A senha do PostgreSQL só vale se for a mesma com que o volume foi
## inicializado: gerar uma nova numa retomada deixaria o FZAP sem banco.
restaurar_segredos_existentes() {
    [ -n "$senha_postgres" ] || senha_postgres=$(recuperar_env_do_servico "postgres_postgres" "POSTGRES_PASSWORD")
    [ -n "$senha_postgres" ] || senha_postgres=$(recuperar_env_do_arquivo "postgres.yaml" "POSTGRES_PASSWORD")
    [ -n "$admin_token" ] || admin_token=$(recuperar_env_do_servico "fzap_fzap" "ADMIN_TOKEN")
    [ -n "$admin_token" ] || admin_token=$(recuperar_env_do_arquivo "fzap.yaml" "ADMIN_TOKEN")

    [ -n "$senha_postgres" ] && log_tecnico "senha do banco recuperada da instalação anterior"
    [ -n "$admin_token" ] && log_tecnico "token de administrador recuperado da instalação anterior"
    return 0
}

instalar_banco() {
    ## Um banco já saudável não é reiniciado sem motivo.
    if stack_saudavel "postgres"; then
        log_tecnico "stack postgres já saudável: nada a fazer"
        return 0
    fi

    criar_volumes_postgres
    gerar_postgres_yaml || return 1
    deploy "postgres" || return 1
    wait_stack "postgres" || return 1
}

instalar_aplicacao() {
    ## Uma retentativa por causa de DNS ou certificado não precisa reiniciar a
    ## aplicação. Um endereço diferente do que está no ar, sim.
    if stack_saudavel "fzap" \
        && [ "$(recuperar_env_do_servico "fzap_fzap" "PUBLIC_BASE_URL")" = "$(url_fzap_completa)" ]; then
        log_tecnico "stack fzap já saudável no endereço esperado: nada a fazer"
        return 0
