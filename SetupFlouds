        echo -e " $amarelo[1]$reset Verificar a instalação"
        echo -e " $amarelo[2]$reset Abrir opções de manutenção"
        echo -e " $amarelo[0]$reset Voltar"
        echo ""
        ler_entrada -p " Escolha: " escolha

        case "$escolha" in
            1)
                estado_restaurar_dados
                etapa5_verificar
                ler_entrada -p " Pressione ENTER para voltar..."
                ;;
            2) menu_manutencao ;;
            0) return 0 ;;
            *) ;;
        esac
    done
}

