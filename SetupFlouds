## ETAPA 5 DE 5 — VERIFICAR E CONCLUIR
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Devolve o resultado real da instalação, sem arredondar:
##   0 = tudo verificado
##   1 = serviços no ar, mas o endereço ainda não responde por HTTPS
##   2 = algum serviço essencial não está de pé
etapa5_verificar() {
    local tentativa
    local banco_ok=false
    local app_ok=false

    titulo_etapa 5 "Verificando"

    for tentativa in 1 2 3; do
        stack_saudavel "postgres" && banco_ok=true && break
        sleep 5
    done
    if [ "$banco_ok" = true ]; then
        item_ok "Banco de dados respondendo"
    else
        item_falha "Banco de dados não iniciou"
    fi

    for tentativa in 1 2 3; do
        stack_saudavel "fzap" && app_ok=true && break
        sleep 5
    done
    if [ "$app_ok" = true ]; then
        item_ok "FZAP em execução"
    else
        item_falha "FZAP não iniciou"
    fi

    if [ "$banco_ok" != true ] || [ "$app_ok" != true ]; then
        echo ""
        return 2
    fi

    if stack_em_reinicio "fzap" || stack_em_reinicio "postgres"; then
        item_falha "Um serviço essencial está reiniciando repetidamente"
        echo ""
        return 2
    fi
    item_ok "Nenhum serviço em ciclo de reinício"

    [ -n "$PORTAINER_API_KEY" ] || obter_token_api_portainer >/dev/null 2>&1 || true
    [ -n "$PORTAINER_URL" ] || PORTAINER_URL="$url_portainer"

    if [ -n "$PORTAINER_API_KEY" ] \
        && preparar_acesso_portainer "$PORTAINER_URL" \
        && portainer_api -fsS -H "X-API-Key: $PORTAINER_API_KEY" \
            "$(painel_api_base "$PORTAINER_URL")/api/users/me" | jq -e '.Id | numbers' >/dev/null 2>&1; then
        item_ok "Painel técnico respondendo"
    else
        item_atencao "Painel técnico ainda não confirmado"
    fi

    ## Sem endereço registrado não há o que testar: acontece ao verificar uma
    ## instalação feita por uma versão anterior do instalador.
    if [ -z "$url_fzap" ]; then
        item_atencao "Endereço do FZAP não registrado neste servidor"
        echo ""
        return 1
    fi

    ## Sem HTTPS não há certificado a esperar: basta o endereço responder.
    if [ "$modo_local" = true ]; then
        for tentativa in 1 2 3 4 5 6; do
            curl -fsS --max-time 10 -o /dev/null "$(url_fzap_completa)" 2>/dev/null && break
            sleep 5
        done
        if curl -fsS --max-time 10 -o /dev/null "$(url_fzap_completa)" 2>/dev/null; then
            item_ok "Endereço acessível"
            echo ""
            return 0
        fi
        item_atencao "O endereço ainda não responde"
        echo ""
        return 1
    fi

    ## O certificado costuma levar alguns segundos após o serviço subir.
    for tentativa in 1 2 3 4 5 6; do
        certificado_valido "$url_fzap" && break
        sleep 10
    done

    if certificado_valido "$url_fzap"; then
        item_ok "Certificado HTTPS válido"
        item_ok "Endereço acessível"
        echo ""
        return 0
    fi

    if url_responde "$url_fzap"; then
        item_atencao "Certificado HTTPS ainda sendo emitido"
    else
        item_atencao "O endereço ainda não responde"
    fi
    echo ""
    return 1
}

