## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## PORTAINER API
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## O Portainer não publica portas: ele só é alcançável através do Traefik, no
## host público. Como o Traefik roteia por SNI/Host, resolver o host para
## 127.0.0.1 permite falar com a API mesmo antes de o DNS existir — e sem abrir
## nenhuma porta nova. A decisão é tomada uma única vez, porque repetir a
## tentativa dentro de um POST duplicaria o efeito da chamada.
portainer_resolve_args=()

preparar_acesso_portainer() {
    local host="$1"

    portainer_resolve_args=()

    ## No modo local o painel publica a própria porta: não há host a resolver.
    if [ "$modo_local" = true ]; then
        if curl -fsS --max-time 15 "$(painel_api_base)/api/status" >/dev/null 2>&1; then
            log_tecnico "painel técnico alcançado em $(painel_api_base)"
            return 0
        fi
        log_tecnico "painel técnico ainda não respondeu em $(painel_api_base)"
        return 1
    fi

    [ -n "$host" ] || return 1

    if curl -k -fsS --max-time 15 --resolve "${host}:443:127.0.0.1" \
        "https://${host}/api/status" >/dev/null 2>&1; then
        portainer_resolve_args=(--resolve "${host}:443:127.0.0.1")
        log_tecnico "painel técnico alcançado localmente (${host} -> 127.0.0.1)"
        return 0
    fi

    if curl -k -fsS --max-time 15 "https://${host}/api/status" >/dev/null 2>&1; then
        log_tecnico "painel técnico alcançado por DNS público (${host})"
        return 0
    fi

    log_tecnico "painel técnico ainda não respondeu em ${host}"
    return 1
}

portainer_api() {
    curl -k "${portainer_resolve_args[@]}" "$@"
}

criar_arquivo_portainer() {
