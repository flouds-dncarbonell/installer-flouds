_instalar_apenas_traefik() {
    ## Este fluxo instala Traefik e Portainer com domínio e HTTPS. O modo local
    ## não se aplica aqui, mesmo que o instalador tenha sido chamado com --local.
    local modo_local=false
    clear
    nome_traefik_portainer
    preencha_as_info

    while true; do
        echo -e "$amarelo Passo 1/3$reset"
        echo -en "$amarelo Nome da rede interna Docker (ex: proxy): $reset" && ler_entrada nome_rede_interna
        echo ""

        echo -e "$amarelo Passo 2/3$reset"
        echo -en "$amarelo E-mail para certificado SSL (ex: contato@seudominio.com): $reset" && ler_entrada email_ssl
        echo ""

        echo -e "$amarelo Passo 3/3$reset"
        echo -en "$amarelo Domínio do Portainer existente (ex: portainer.seudominio.com): $reset" && ler_entrada url_portainer
