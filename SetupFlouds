init_portainer_admin() {
    local MAX_RETRIES=4
    local DELAY=15
    local CONTA_CRIADA=false
    local AUTH_RESPONSE
    local SETUP_TOKEN

    echo ""
    echo -e "$amarelo• Inicializando conta admin do Portainer...$reset"

    for i in $(seq 1 $MAX_RETRIES); do
        ## A cada tentativa reavalia como alcançar o painel: na primeira volta o
        ## serviço pode ainda não estar aceitando conexões.
        preparar_acesso_portainer "$url_portainer" || true

        AUTH_RESPONSE=$(portainer_api -s -X POST "$(painel_api_base "$url_portainer")/api/auth" \
            -H "Content-Type: application/json" \
            --data "$(jq -n --arg usuario "$user_portainer" --arg senha "$pass_portainer" \
                '{Username: $usuario, Password: $senha}')")

        if echo "$AUTH_RESPONSE" | jq -e '.jwt | strings | length > 0' >/dev/null 2>&1; then
            echo -e "$verde  ✔ Conta de administrador validada com sucesso!$reset"
            CONTA_CRIADA=true
            break
        fi

        ## Portainer 2.39+ protege a inicialização com um token exibido apenas
        ## nos logs do serviço. Versões anteriores aceitam a mesma chamada sem ele.
        SETUP_TOKEN=$(docker service logs --raw portainer_portainer --tail 100 2>&1 \
            | sed -E 's/\x1B\[[0-9;]*[mK]//g' \
            | grep -oE 'setup_token=[a-f0-9]{64}' | tail -1 | cut -d= -f2)

        if [ -n "$SETUP_TOKEN" ]; then
            RESPONSE=$(portainer_api -s -X POST "$(painel_api_base "$url_portainer")/api/users/admin/init" \
                -H "Content-Type: application/json" \
                -H "X-Setup-Token: $SETUP_TOKEN" \
                --data "$(jq -n --arg usuario "$user_portainer" --arg senha "$pass_portainer" \
                    '{Username: $usuario, Password: $senha}')")
        else
            RESPONSE=$(portainer_api -s -X POST "$(painel_api_base "$url_portainer")/api/users/admin/init" \
                -H "Content-Type: application/json" \
                --data "$(jq -n --arg usuario "$user_portainer" --arg senha "$pass_portainer" \
                    '{Username: $usuario, Password: $senha}')")
        fi

        if echo "$RESPONSE" | jq -e --arg usuario "$user_portainer" \
            '.Username == $usuario' >/dev/null 2>&1; then
            echo -e "$verde  ✔ Conta de administrador criada com sucesso!$reset"
            CONTA_CRIADA=true
            break
        else
            if [ "$i" -eq "$MAX_RETRIES" ]; then
                echo -e "$vermelho  ✘ Não foi possível validar a conta admin após $MAX_RETRIES tentativas.$reset"
                return 1
            else
                echo -e "$bege    Aguardando Portainer iniciar... ($i/$MAX_RETRIES)$reset"
                sleep $DELAY
            fi
        fi
    done

    [ "$CONTA_CRIADA" = true ]
}

