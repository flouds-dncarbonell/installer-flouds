## Carrega dados da VPS salva
dados() {
    if [ -f "$dados_vps" ]; then
        nome_servidor=$(grep "Nome do Servidor:" "$dados_vps" | awk -F': ' '{print $2}')
        nome_rede_interna=$(grep "Rede interna:" "$dados_vps" | awk -F': ' '{print $2}')
    fi
}

## Gera string aleatória segura
gerar_token() {
    local tamanho="${1:-32}"
    tr -dc 'A-Za-z0-9' < /dev/urandom | head -c "$tamanho"
}

## Oculta senha para exibição
esconder_senha() {
    local senha="$1"
    local visivel=4
    local tamanho=${#senha}
    if [ "$tamanho" -le "$visivel" ]; then
        SENHAOCULTA="****"
    else
        SENHAOCULTA="${senha:0:$visivel}$(printf '*%.0s' $(seq 1 $((tamanho - visivel))))"
    fi
}

## Valida senha
validar_senha() {
    local senha="$1"
    local min="${2:-12}"
    if [ ${#senha} -lt "$min" ]; then
        echo -e "$vermelho  Senha muito curta. Mínimo $min caracteres.$reset"
        return 1
    fi
    if [ ${#senha} -gt 128 ]; then
        echo -e "$vermelho  Senha muito longa. Máximo 128 caracteres.$reset"
        return 1
    fi
    if [[ "$senha" == *[[:cntrl:]]* ]]; then
        echo -e "$vermelho  A senha não pode conter caracteres de controle.$reset"
        return 1
    fi
    return 0
}

## Remove espaços externos, protocolo e uma barra final. Caminhos e portas
## permanecem no valor para que a validação os rejeite explicitamente.
normalizar_dominio() {
    local dominio="$1"
    local dominio_minusculo

    dominio="${dominio#"${dominio%%[![:space:]]*}"}"
    dominio="${dominio%"${dominio##*[![:space:]]}"}"
    dominio_minusculo="${dominio,,}"

    if [[ "$dominio_minusculo" == http://* ]]; then
        dominio="${dominio:7}"
    elif [[ "$dominio_minusculo" == https://* ]]; then
        dominio="${dominio:8}"
    fi

    dominio="${dominio%/}"
    dominio="${dominio%.}"
    echo "${dominio,,}"
}

eh_dominio_valido() {
    local dominio="$1"
    local rotulo
    local tld

    [ -n "$dominio" ] && [ ${#dominio} -le 253 ] || return 1
    [[ "$dominio" == *.* ]] || return 1
    [[ "$dominio" != *[!A-Za-z0-9.-]* ]] || return 1
    [[ "$dominio" != .* && "$dominio" != *. && "$dominio" != *..* ]] || return 1

    IFS='.' read -ra rotulos <<< "$dominio"
    for rotulo in "${rotulos[@]}"; do
        [ -n "$rotulo" ] && [ ${#rotulo} -le 63 ] || return 1
        [[ "$rotulo" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
    done
    tld="${dominio##*.}"
    [ ${#tld} -ge 2 ] && [[ "$tld" == *[A-Za-z]* ]] || return 1

    return 0
}

validar_dominio() {
    if ! eh_dominio_valido "$1"; then
        echo -e "$vermelho  Domínio inválido. Informe apenas o host, por exemplo: app.seudominio.com.$reset"
        return 1
    fi
    return 0
}

validar_email() {
    local email="$1"
    local local_part dominio

    [ -n "$email" ] && [ ${#email} -le 254 ] || {
        echo -e "$vermelho  E-mail inválido.$reset"
        return 1
    }
    [[ "$email" != *[[:space:]]* && "$email" == *@* && "$email" != *@*@* ]] || {
        echo -e "$vermelho  E-mail inválido.$reset"
        return 1
    }

    local_part="${email%@*}"
    dominio="${email##*@}"
    if [ -z "$local_part" ] || [ ${#local_part} -gt 64 ] \
        || [[ "$local_part" == .* || "$local_part" == *. || "$local_part" == *..* ]] \
        || [[ ! "$local_part" =~ ^[A-Za-z0-9.!#$%\'*+/=?^_\`{|}~-]+$ ]] \
        || ! eh_dominio_valido "${dominio,,}"; then
        echo -e "$vermelho  E-mail inválido.$reset"
        return 1
    fi
    return 0
}

validar_rede_docker() {
    if [[ ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$ ]]; then
        echo -e "$vermelho  Nome de rede inválido. Use até 255 letras, números, ponto, hífen ou sublinhado.$reset"
        return 1
    fi
    return 0
}

validar_usuario_portainer() {
    if [ -z "$1" ] || [ ${#1} -gt 128 ] || [[ "$1" == *[[:cntrl:]]* ]]; then
        echo -e "$vermelho  Usuário inválido. Use de 1 a 128 caracteres, sem caracteres de controle.$reset"
        return 1
    fi
    return 0
}

validar_texto_livre() {
    local valor="$1"
    local max="${2:-200}"
    local obrigatorio="${3:-false}"

    if [ "$obrigatorio" = true ] && [ -z "$valor" ]; then
        echo -e "$vermelho  Este campo é obrigatório.$reset"
        return 1
    fi
    if [ ${#valor} -gt "$max" ] || [[ "$valor" == *[[:cntrl:]]* ]]; then
        echo -e "$vermelho  Valor inválido. Use no máximo $max caracteres em uma única linha.$reset"
        return 1
    fi
    return 0
}

validar_url_https_opcional() {
    local url="$1"
    local host

    [ -z "$url" ] && return 0
    [[ "$url" == https://* && "$url" != *[[:space:]]* ]] || {
        echo -e "$vermelho  URL inválida. Use uma URL HTTPS completa.$reset"
        return 1
    }
    host="${url#https://}"
    host="${host%%/*}"
    validar_dominio "$host"
}

## JSON também é um escalar YAML válido. Isso impede que valores livres
## alterem a estrutura do arquivo Compose.
yaml_quote() {
    jq -Rn --arg valor "$1" '$valor'
}

ler_campo_arquivo() {
    local arquivo="$1"
    local prefixo="$2"
    awk -v prefixo="$prefixo" \
        'index($0, prefixo) == 1 { print substr($0, length(prefixo) + 1); exit }' \
        "$arquivo"
}

atualizar_campo_arquivo() {
    local arquivo="$1"
    local prefixo="$2"
    local valor="$3"
    local temporario

    temporario=$(mktemp)
    awk -v prefixo="$prefixo" -v valor="$valor" '
        index($0, prefixo) == 1 { print prefixo valor; atualizado=1; next }
        { print }
        END { if (!atualizado) print prefixo valor }
    ' "$arquivo" > "$temporario" || {
        rm -f "$temporario"
        return 1
    }
    chmod 600 "$temporario"
    mv -f "$temporario" "$arquivo"
}

## Verifica recursos mínimos (vCPU e GB RAM)
recursos() {
    local vcpu_req=$1
    local ram_req=$2

    local vcpu_disp
    local ram_kb
    local ram_req_kb
    local ram_disp

    vcpu_disp=$(nproc 2>/dev/null || echo 1)
    ram_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
    ram_kb=${ram_kb:-0}
    ## Provedores anunciam a capacidade nominal da VPS, enquanto o Linux
    ## desconta uma pequena parte reservada ao sistema. Aceitamos até 5% dessa
    ## diferença para não reprovar uma VPS comercializada como 2 GB.
    ram_req_kb=$((ram_req * 950000))
    ram_disp=$(awk -v kb="$ram_kb" 'BEGIN { printf "%.1f", kb / 1000000 }')

    if [ "$vcpu_disp" -lt "$vcpu_req" ] || [ "$ram_kb" -lt "$ram_req_kb" ]; then
        clear
        erro_msg
        echo ""
        echo -e " Recursos insuficientes para esta instalação."
        echo -e " Necessário: $amarelo${vcpu_req} vCPU$reset e $amarelo${ram_req}GB RAM$reset"
        echo -e " Disponível: $amarelo${vcpu_disp} vCPU$reset e $amarelo${ram_disp}GB RAM$reset"
        echo ""
        echo -e " Deseja continuar mesmo assim? (y/n): "
        ler_entrada escolha
        if [ "$escolha" != "y" ] && [ "$escolha" != "Y" ]; then
            return 0
        fi
    fi
    return 1
}

## Endereços exibidos e usados pelo instalador. Numa instalação local não há
## domínio nem HTTPS: tudo passa por portas publicadas no próprio host.
url_fzap_completa() {
    if [ "$modo_local" = true ]; then
        echo "http://localhost:${porta_fzap_local}"
    else
        echo "https://${url_fzap}"
    fi
}

url_painel_completa() {
    if [ "$modo_local" = true ]; then
        echo "http://localhost:${porta_painel_local}"
    else
        echo "https://${1:-$url_portainer}"
    fi
}

## Base usada nas chamadas à API do painel. No modo local fala direto com a
## porta publicada; caso contrário passa pelo Traefik, no host público.
painel_api_base() {
    if [ "$modo_local" = true ]; then
        echo "http://127.0.0.1:${porta_painel_local}"
    else
        echo "https://${1:-$url_portainer}"
    fi
}

obter_ip_publico() {
    curl -fsS4 --max-time 10 https://ifconfig.me 2>/dev/null \
        || curl -fsS4 --max-time 10 https://api.ipify.org 2>/dev/null
}

## Consulta o IP público uma única vez por execução.
ip_publico_cache=""
ip_publico() {
    [ -n "$ip_publico_cache" ] && { echo "$ip_publico_cache"; return 0; }
    ip_publico_cache=$(obter_ip_publico)
    echo "$ip_publico_cache"
}

## Verifica o DNS de um host e devolve um resultado estruturado, sem escrever
## nada na tela: a camada de apresentação decide a mensagem.
##   0 = aponta para esta VPS
##   1 = não resolve em DNS público
##   2 = resolve, mas para outro IP (proxy tipo Cloudflare, por exemplo)
##   3 = IP público da VPS indeterminado
## Os IPs encontrados ficam em dns_ips_encontrados.
dns_ips_encontrados=""
checar_dns_host() {
    local host="$1"
    local ip_vps

    dns_ips_encontrados=""
    ip_vps=$(ip_publico)

    dns_ips_encontrados=$(getent ahostsv4 "$host" 2>/dev/null \
        | awk '{print $1}' | sort -u | tr '\n' ' ')
    dns_ips_encontrados="${dns_ips_encontrados% }"

    [ -z "$ip_vps" ] && return 3
    [ -z "$dns_ips_encontrados" ] && return 1

    if echo "$dns_ips_encontrados" | tr ' ' '\n' | grep -qx "$ip_vps"; then
        return 0
    fi
    return 2
}

## Mostra o registro DNS que falta, no formato do painel do provedor.
mostrar_registro_dns() {
    local host="$1"
    local base="$2"
    local ip_vps
    local nome

    ip_vps=$(ip_publico)

    ## O formato de tabela só é possível quando conhecemos o domínio-base. Sem
    ## ele, deduzir o nome do registro erraria com sufixos como com.br, então o
    ## host completo é mostrado como está.
    if [ -n "$base" ] && [ "$host" != "${host%".$base"}" ]; then
        nome="${host%".$base"}"
        echo -e "$bege   Crie este registro no painel do seu provedor de domínio:$reset"
        echo ""
        printf '     %-6s %-10s %s\n' "Tipo" "Nome" "Valor"
        printf '     %-6s %-10s %s\n' "A" "$nome" "${ip_vps:-<IP desta VPS>}"
        echo ""
        return 0
    fi

    echo -e "$bege   No painel do seu provedor de domínio, crie um registro A para$reset"
    echo -e "$bege   ${host} apontando para ${ip_vps:-o IP desta VPS}.$reset"
    echo ""
}

configurar_firewall_http_https() {
    ## Numa instalação local o acesso vem da própria máquina: não há nada a
    ## abrir no firewall, e abrir seria expor o painel sem HTTPS.
    [ "$modo_local" = true ] && return 0

    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi "Status: active"; then
        echo -e "$amarelo• Liberando portas 80/443 no UFW...$reset"
        ufw allow 80/tcp >/dev/null 2>&1
        ufw allow 443/tcp >/dev/null 2>&1
        echo -e "$verde  ✔ Firewall local OK$reset"
        echo ""
    fi
}

## As portas que a instalação precisa publicar, conforme o modo.
porta_publicada_fzap() {
    if [ "$modo_local" = true ]; then echo "$porta_fzap_local"; else echo 80; fi
}

porta_publicada_painel() {
    if [ "$modo_local" = true ]; then echo "$porta_painel_local"; else echo 443; fi
}

## Devolve, separadas por espaço, as portas necessárias que já estão ocupadas.
## Uma porta publicada pelo próprio Docker não conta: quem escuta ali somos nós.
portas_em_uso() {
    local ocupadas="" porta escutando

    command -v ss >/dev/null 2>&1 || return 0
    escutando=$(ss -ltnH 2>/dev/null | awk '{print $4}')

    for porta in "$(porta_publicada_fzap)" "$(porta_publicada_painel)"; do
        printf '%s\n' "$escutando" | grep -Eq "(^|:)${porta}\$" \
            && ocupadas="$ocupadas $porta"
    done
    echo "$ocupadas"
}

## Usada apenas pelo fluxo do Traefik, no menu avançado: ali as portas são
## sempre 80 e 443, independente de o instalador ter sido chamado com --local.
validar_portas_http_https() {
    local portas_ocupadas=""

    if command -v ss >/dev/null 2>&1; then
        ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)80$' && portas_ocupadas="$portas_ocupadas 80"
        ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)443$' && portas_ocupadas="$portas_ocupadas 443"
    fi

    if [ -n "$portas_ocupadas" ] && ! docker service ls --format "{{.Name}}" 2>/dev/null | grep -q "^traefik_traefik$"; then
        clear
        erro_msg
        echo ""
        echo -e " As portas$amarelo$portas_ocupadas$reset já parecem estar em uso."
        echo -e " O Traefik precisa publicar as portas $amarelo80$reset e $amarelo443$reset para emitir SSL."
        echo ""
        echo -e " Pare o serviço que usa essas portas e tente novamente."
        echo ""
        sleep 8
        return 1
    fi

    return 0
}

validar_dominio_para_ssl() {
    local dominio
    local ip_vps
    local ips_dominio

    dominio=$(normalizar_dominio "$1")
    validar_dominio "$dominio" || return 1
    ip_vps=$(obter_ip_publico)
    ips_dominio=$(getent ahostsv4 "$dominio" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')

    if [ -z "$ip_vps" ]; then
        echo -e "$bege  ⚠ Não foi possível detectar o IP público da VPS. Continuando.$reset"
        echo ""
        return 0
    fi

    if [ -z "$ips_dominio" ]; then
        clear
        erro_msg
        echo ""
        echo -e " O domínio $amarelo$dominio$reset não resolveu em DNS público."
        echo -e " Crie um registro A apontando para o IP da VPS: $amarelo$ip_vps$reset"
        echo ""
        echo -e " Sem isso, a Let's Encrypt não consegue emitir o certificado SSL."
        echo ""
        sleep 10
        return 1
    fi

    if ! echo "$ips_dominio" | tr ' ' '\n' | grep -qx "$ip_vps"; then
        clear
        erro_msg
        echo ""
        echo -e " O domínio $amarelo$dominio$reset não aponta diretamente para esta VPS."
        echo -e " IP da VPS: $amarelo$ip_vps$reset"
        echo -e " IP(s) do domínio: $amarelo$ips_dominio$reset"
        echo ""
        echo -e " Para SSL automático, o domínio precisa chegar nesta VPS pelas portas 80 e 443."
        echo -e " Se você usa proxy como Cloudflare, pode continuar desde que ele esteja apontando para esta VPS."
        echo ""
        ler_entrada -p "Deseja continuar mesmo assim? (Y/N): " confirmar_dns
        [ "$confirmar_dns" = "Y" ] || [ "$confirmar_dns" = "y" ] || return 1
    fi

    return 0
}

## O script do Docker roda apt-get/dnf internamente; em VPS recém-criada o lock
## do dpkg ainda pode estar com o unattended-upgrades. Espera antes de seguir.
aguardar_lock_pacotes() {
    local limite=${1:-600} esperado=0 avisou=0 arquivo ocupado

    command -v fuser >/dev/null 2>&1 || return 0

    while :; do
        ocupado=0
        for arquivo in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock \
                       /var/lib/apt/lists/lock /var/cache/apt/archives/lock \
                       /var/run/yum.pid; do
            [ -e "$arquivo" ] || continue
            if fuser "$arquivo" >/dev/null 2>&1; then
                ocupado=1
                break
            fi
        done
        [ "$ocupado" -eq 0 ] && break

        if [ "$avisou" -eq 0 ]; then
            echo -e "$amarelo  Aguardando o fim das atualizações automáticas do sistema...$reset"
            avisou=1
        fi

        [ "$esperado" -ge "$limite" ] && break

        sleep 5
        esperado=$((esperado + 5))
    done

    return 0
}

instalar_docker() {
    echo -e "$amarelo• Verificando Docker...$reset"

    if ! command -v docker >/dev/null 2>&1; then
        echo -e "$amarelo  Docker não encontrado. Instalando Docker...$reset"
        aguardar_lock_pacotes
        curl -fsSL https://get.docker.com | sh >/dev/null 2>&1 || {
            echo -e "$vermelho  ✖ Falha ao instalar Docker$reset"
            return 1
        }
        echo -e "$verde  ✔ Docker instalado$reset"
    else
        echo -e "$verde  ✔ Docker já instalado$reset"
    fi

    systemctl enable docker >/dev/null 2>&1 || true
    systemctl start docker >/dev/null 2>&1 || {
        echo -e "$vermelho  ✖ Falha ao iniciar o serviço Docker$reset"
        return 1
    }

    docker version >/dev/null 2>&1 || {
        echo -e "$vermelho  ✖ Docker instalado, mas não respondeu corretamente$reset"
        return 1
    }

    echo -e "$verde  ✔ Docker OK$reset"
    echo ""
}

## IP que o Swarm deve anunciar. Num servidor com mais de um endereço o Docker
## se recusa a escolher sozinho, e é essa a falha mais comum do swarm init.
ip_para_anunciar() {
    local ip
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null \
        | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    [ -n "$ip" ] || ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "$ip"
}

## Inicia o Swarm registrando o motivo real da falha no log técnico. A segunda
## tentativa informa explicitamente o IP a anunciar; a terceira usa o loopback,
## que basta para um nó único — inclusive numa instalação local.
iniciar_swarm() {
    local saida ip estado

    if saida=$(docker swarm init 2>&1); then
        return 0
    fi
    log_tecnico "docker swarm init falhou: $(printf '%s' "$saida" | tr '\n' ' ')"

    estado=$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)
    case "$estado" in
        active) return 0 ;;
        pending|locked)
            echo -e "$vermelho  ✖ O Docker Swarm está em estado \"$estado\".$reset"
            echo -e "$bege    Execute$reset$amarelo docker swarm leave --force$reset$bege e tente novamente.$reset"
            return 1
            ;;
    esac

    ip=$(ip_para_anunciar)
    if [ -n "$ip" ]; then
        if saida=$(docker swarm init --advertise-addr "$ip" 2>&1); then
            log_tecnico "swarm iniciado anunciando $ip"
            return 0
        fi
        log_tecnico "docker swarm init --advertise-addr $ip falhou: $(printf '%s' "$saida" | tr '\n' ' ')"
    fi

    if saida=$(docker swarm init --advertise-addr 127.0.0.1 2>&1); then
        log_tecnico "swarm iniciado anunciando 127.0.0.1"
        return 0
    fi

    log_tecnico "docker swarm init --advertise-addr 127.0.0.1 falhou: $(printf '%s' "$saida" | tr '\n' ' ')"
    echo -e "$vermelho  ✖ Falha ao iniciar Docker Swarm$reset"
    echo -e "$bege    $(printf '%s' "$saida" | head -1)$reset"
    return 1
}

preparar_docker_swarm() {
    instalar_docker || return 1

    echo -e "$amarelo• Inicializando Docker Swarm...$reset"
    SWARM_STATUS=$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)
    if [ "$SWARM_STATUS" != "active" ]; then
        iniciar_swarm || return 1
    fi
    echo -e "$verde  ✔ Swarm OK$reset"
    echo ""
}

criar_rede_interna() {
    echo -e "$amarelo• Criando rede $nome_rede_interna...$reset"
    docker network inspect "$nome_rede_interna" >/dev/null 2>&1 \
        || docker network create --driver=overlay --attachable "$nome_rede_interna" >/dev/null 2>&1 \
        || {
            echo -e "$vermelho  ✖ Falha ao criar rede $nome_rede_interna$reset"
            return 1
        }
    echo -e "$verde  ✔ Rede OK$reset"
    echo ""
}

validar_rede_interna_existente() {
    if ! docker network inspect "$nome_rede_interna" >/dev/null 2>&1; then
        clear
        erro_msg
        echo ""
        echo -e " A rede Docker $amarelo$nome_rede_interna$reset não existe."
        echo -e " Informe exatamente a mesma rede usada pelo Traefik existente."
        echo ""
        sleep 8
        return 1
    fi

    return 0
}

wait_stack() {
    local stack="$1"
    local tentativa=1
    local max_tentativas="${2:-36}"
    local intervalo="${3:-5}"
    local pendentes

    echo -e "$amarelo• Aguardando serviços da stack $stack ficarem online...$reset"

    while [ "$tentativa" -le "$max_tentativas" ]; do
        pendentes=$(docker stack services "$stack" --format "{{.Name}} {{.Replicas}}" 2>/dev/null | awk '{
            split($2, replicas, "/")
            if (replicas[1] != replicas[2] || replicas[2] == "0") print $0
        }')

        if [ -z "$pendentes" ] && [ -n "$(docker stack services "$stack" --format "{{.Name}}" 2>/dev/null)" ]; then
            echo -e "$verde  ✔ Stack $stack online$reset"
            echo ""
            return 0
        fi

        sleep "$intervalo"
        tentativa=$((tentativa + 1))
    done

    echo -e "$vermelho  ✖ Stack $stack não ficou online dentro do tempo esperado$reset"
    echo ""
    docker stack services "$stack" 2>/dev/null
    echo ""
    echo -e " Verifique com:"
    echo -e " $amarelo docker service ps ${stack}_NOME_DO_SERVICO --no-trunc$reset"
    echo -e " $amarelo docker service logs ${stack}_NOME_DO_SERVICO --tail 100$reset"
    echo ""
    return 1
}

