## Prepara Traefik e Portainer sem fazer nenhuma pergunta: os dados já foram
## coletados nas etapas 2 e 3. Uma infraestrutura já existente é reutilizada.
preparar_infraestrutura() {
    if _infra_pronta; then
        if [ ! -f "$dados_portainer_file" ] \
            || [ -z "$(ler_campo_arquivo "$dados_portainer_file" "Senha: ")" ]; then
            log_tecnico "infraestrutura existente sem credenciais registradas"
            return 2
        fi
        user_portainer=$(ler_campo_arquivo "$dados_portainer_file" "Usuario: ")
        pass_portainer=$(ler_campo_arquivo "$dados_portainer_file" "Senha: ")
        executar_passo "Infraestrutura existente reutilizada" true
        executar_passo "Rede interna verificada" criar_rede_interna || return 1
        ## Também é por aqui que passa a retentativa de uma preparação que
        ## falhou justamente ao criar a conta do painel: init_portainer_admin
        ## autentica quando a conta já existe e só cria quando falta.
        executar_passo "Conta do painel verificada" init_portainer_admin || return 1
        return 0
    fi

    user_portainer="admin"
    pass_portainer=$(gerar_token 24)

    executar_passo "Dados do servidor salvos" salvar_dados_servidor || return 1
    executar_passo "Docker preparado" preparar_docker_swarm || return 1
    executar_passo "Rede interna criada" criar_rede_interna || return 1
    ## Sem domínio não há certificado a emitir, e portanto não há Traefik.
    if [ "$modo_local" != true ]; then
        executar_passo "Portas 80 e 443 liberadas" configurar_firewall_http_https || return 1
        executar_passo "Acesso HTTPS configurado" deploy_traefik || return 1
    fi
    executar_passo "Painel técnico instalado" deploy_portainer || return 1
    executar_passo "Credenciais do painel salvas" salvar_dados_painel || return 1
    executar_passo "Conta do painel criada" init_portainer_admin || return 1
    return 0
}

etapa4_instalar() {
    local resultado

    titulo_etapa 4 "Instalando"
    passo_atual=0

    ## Os arquivos das stacks são gerados no diretório de dados e enviados a
    ## partir dele.
    cd "$home_directory" || return 1

    if _infra_pronta; then
        passos_total=5
    elif [ "$modo_local" = true ]; then
        passos_total=8
    else
