## COLETA DE DADOS
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Um read que falha significa entrada encerrada — terminal não interativo, ou
## /dev/tty indisponível num curl|bash. Sem esta guarda, todo laço de pergunta
## giraria para sempre consumindo CPU em vez de terminar com uma mensagem.
##
## O prompt de "read -p" é escrito em STDERR, e não em stdout: suprimir stderr
## aqui apagaria toda pergunta da tela. Por isso as leituras abaixo nunca
## redirecionam o descritor 2.
ler_entrada() {
    local ok=0

    if [ "$entrada_tty" = true ]; then
        read -r "$@" </dev/tty || ok=1
    else
        read -r "$@" || ok=1
    fi

    if [ "$ok" -ne 0 ]; then
        echo ""
        echo -e "$vermelho Entrada encerrada. Execute o instalador em um terminal interativo.$reset"
        exit 1
    fi
}

## Mesma leitura, para senhas: não ecoa o que é digitado.
ler_senha() {
    local ok=0

    if [ "$entrada_tty" = true ]; then
        read -rs "$@" </dev/tty || ok=1
    else
        read -rs "$@" || ok=1
    fi
    echo ""

    if [ "$ok" -ne 0 ]; then
        echo -e "$vermelho Entrada encerrada. Execute o instalador em um terminal interativo.$reset"
        exit 1
    fi
}

perguntar_dominio_base() {
    local resposta

    while true; do
        echo -e "$branco Qual é o seu domínio?$reset"
        echo -e "$bege Exemplo: empresa.com.br$reset"
        echo ""
        ler_entrada -p " > " resposta
        echo ""

        resposta=$(normalizar_dominio "$resposta")
        if [ -z "$resposta" ]; then
            item_falha "Informe um domínio para continuar."
            echo ""
            continue
        fi
        if ! eh_dominio_valido "$resposta"; then
            item_falha "Domínio inválido. Informe apenas o domínio, sem http:// e sem barras."
            echo ""
            continue
        fi

        dominio_base="$resposta"
        return 0
    done
}

## O idioma tem padrão: quem não se importa pressiona Enter.
perguntar_idioma() {
    local escolha

    while true; do
        echo -e "$branco Idioma do FZAP$reset"
        echo -e "$bege Enter usa pt-BR. Outras opções: 2 = en-US, 3 = es-LATAM$reset"
        ler_entrada -p " > " escolha

        case "$escolha" in
            ""|1|pt-BR|pt-br) fzap_language="pt-BR"; break ;;
            2|en-US|en-us)    fzap_language="en-US"; break ;;
            3|es-LATAM|es-latam) fzap_language="es-LATAM"; break ;;
            *) item_falha "Opção inválida. Pressione Enter, ou digite 2 ou 3." ;;
        esac
    done
    echo ""
}

## O e-mail é sempre solicitado: ele sai deste servidor e vai para a Let's
## Encrypt, então não é um campo que o instalador deva preencher sozinho.
perguntar_email() {
    while true; do
        echo -e "$branco E-mail para avisos de vencimento do certificado$reset"
        echo -e "$bege Exemplo: contato@${dominio_base:-empresa.com.br}$reset"
        ler_entrada -p " > " email_ssl
        validar_email "$email_ssl" && break
    done
    echo ""
}

perguntar_licenca() {
    while true; do
        echo -e "$branco Chave de licença Flouds$reset"
        echo -e "$bege Enter usa a versão gratuita.$reset"
        ler_entrada -p " > " licence_key
        validar_texto_livre "$licence_key" 512 && break
    done
    echo ""
}

## Campos comerciais do Chatwoot. Só aparecem para quem informou licença.
perguntar_chatwoot() {
    chatwoot_identifier=""
    chatwoot_system_name=""
    chatwoot_platform_name=""
    chatwoot_service_url=""

    [ -n "$licence_key" ] || return 0

    echo -e "$branco Integração com o Chatwoot$reset"
