#!/bin/bash

## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
##                           FLOUDS INSTALLER                              ##
##     Estrutura inspirada no SetupOrion: https://github.com/oriondesign2015/SetupOrion
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

versao="1.4.0"
traefik_image="traefik:v3.6.17"
portainer_image="portainer/portainer-ce:2.39.5"
portainer_agent_image="portainer/agent:2.39.5"
rede_padrao="proxy"
modo_infra=false
modo_verbose=false

## Instalação local: sem domínio, sem Traefik e sem HTTPS. O FZAP e o painel
## publicam portas direto no host. Serve para testar numa máquina de trabalho.
modo_local=false
porta_fzap_local=8080
porta_painel_local=9000

## Dados de acesso, hashes e arquivos ACME criados pelo instalador ficam restritos ao root.
umask 077

for argumento in "$@"; do
    case "$argumento" in
        --infra-only) modo_infra=true ;;
        --verbose) modo_verbose=true ;;
        --local) modo_local=true ;;
        -h|--help)
            echo "Uso: $0 [--infra-only] [--local] [--verbose]"
            echo "  --infra-only  instala somente Traefik e Portainer"
            echo "  --local       instala em localhost, sem domínio e sem HTTPS"
            echo "  --verbose     mostra os detalhes técnicos durante a instalação"
            exit 0
            ;;
        *)
            echo "Opção desconhecida: $argumento" >&2
            exit 2
            ;;
    esac
done

## Cores. NO_COLOR=1 desativa os códigos ANSI sem alterar o texto das mensagens:
## todo estado também é indicado por marcador (✔ ● ⚠ ✖) e por palavra.
if [ -n "${NO_COLOR:-}" ]; then
    amarelo=""
    verde=""
    branco=""
    bege=""
    vermelho=""
    reset=""
else
    amarelo="\e[33m"
    verde="\e[32m"
    branco="\e[97m"
    bege="\e[93m"
    vermelho="\e[91m"
    reset="\e[0m"
fi

## Descobre por onde as perguntas devem ser lidas. Num curl | bash o stdin do
## script é o próprio código-fonte: ler dali faria o instalador responder a si
## mesmo e terminar sozinho. O redirecionamento não pode ser feito no script
## inteiro (o bash ainda precisa ler o resto do código pelo stdin), então cada
## pergunta lê de /dev/tty individualmente — é o que $entrada_tty indica.
## O teste é abrir /dev/tty de fato: num processo sem terminal de controle o
## arquivo existe e parece legível, mas a abertura falha. Só aqui o stderr é
## silenciado, para que essa tentativa não deixe um erro cru na tela.
entrada_tty=false
if [ ! -t 0 ] && (exec </dev/tty) 2>/dev/null; then
    entrada_tty=true
fi

## Diretório de dados
home_directory="$HOME"
dados_vps="${home_directory}/dados_vps/dados_vps"
dados_portainer_file="${home_directory}/dados_vps/dados_portainer"
estado_file="${home_directory}/dados_vps/estado_instalacao"
log_file="${home_directory}/dados_vps/instalacao.log"

