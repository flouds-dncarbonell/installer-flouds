## ESTADO E RETOMADA
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Etapas registradas no arquivo de estado, em ordem. Cada valor só é gravado
## depois de uma verificação objetiva do resultado, nunca ao disparar o comando.
estado_ordem="verificado_servidor dns_ok dados_confirmados infra_pronta postgres_saudavel fzap_saudavel concluido"

estado_ler() {
    local campo="$1"
    [ -f "$estado_file" ] || return 0
    ler_campo_arquivo "$estado_file" "${campo}: "
}

## Grava o estado de forma atômica para que uma interrupção no meio da escrita
## não deixe um arquivo pela metade.
estado_gravar() {
    local etapa="$1"
    local situacao="${2:-em_andamento}"
    local temporario

    mkdir -p "$(dirname "$estado_file")" 2>/dev/null
    temporario=$(mktemp) || return 1
    {
        echo "Versao do instalador: $versao"
        echo "Etapa concluida: $etapa"
        echo "Situacao: $situacao"
        echo "Dominio base: ${dominio_base:-}"
        echo "Dominio fzap: ${url_fzap:-}"
        echo "Dominio painel: ${url_portainer:-}"
        echo "Email SSL: ${email_ssl:-}"
        echo "Idioma: ${fzap_language:-}"
        echo "Rede interna: ${nome_rede_interna:-}"
        echo "Modo local: ${modo_local:-false}"
        ## A licença e os campos do Chatwoot ficam aqui porque uma retomada
        ## precisa reconstruir exatamente a mesma stack. Sem isso, retomar
        ## reinstalaria o FZAP como versão gratuita.
        echo "Licenca: ${licence_key:-}"
        echo "Chatwoot identificador: ${chatwoot_identifier:-}"
        echo "Chatwoot nome: ${chatwoot_system_name:-}"
        echo "Chatwoot plataforma: ${chatwoot_platform_name:-}"
        echo "Chatwoot url: ${chatwoot_service_url:-}"
        echo "Ultima verificacao: $(date '+%Y-%m-%d %H:%M:%S')"
    } > "$temporario" || {
        rm -f "$temporario"
        return 1
    }
    chmod 600 "$temporario"
    mv -f "$temporario" "$estado_file"
    log_tecnico "estado gravado: etapa=$etapa situacao=$situacao"
}

estado_limpar() {
    rm -f "$estado_file" 2>/dev/null
    return 0
}

## Verdadeiro quando a etapa informada já foi concluída em uma execução anterior.
estado_alcancou() {
    local alvo="$1"
    local concluida
    local etapa

    concluida=$(estado_ler "Etapa concluida")
    [ -n "$concluida" ] || return 1

    ## Percorre a ordem das etapas: se o alvo aparece antes da etapa concluída
    ## (ou é ela mesma), então o alvo já ficou para trás.
    for etapa in $estado_ordem; do
        [ "$etapa" = "$alvo" ] && return 0
        [ "$etapa" = "$concluida" ] && return 1
    done
    return 1
}

## Recarrega no ambiente os dados já confirmados em uma execução anterior.
estado_restaurar_dados() {
    dominio_base=$(estado_ler "Dominio base")
    url_fzap=$(estado_ler "Dominio fzap")
    url_portainer=$(estado_ler "Dominio painel")
    email_ssl=$(estado_ler "Email SSL")
    fzap_language=$(estado_ler "Idioma")
    nome_rede_interna=$(estado_ler "Rede interna")
    [ "$(estado_ler "Modo local")" = "true" ] && modo_local=true
    licence_key=$(estado_ler "Licenca")
    chatwoot_identifier=$(estado_ler "Chatwoot identificador")
    chatwoot_system_name=$(estado_ler "Chatwoot nome")
    chatwoot_platform_name=$(estado_ler "Chatwoot plataforma")
    chatwoot_service_url=$(estado_ler "Chatwoot url")
    [ -n "$nome_rede_interna" ] || nome_rede_interna="$rede_padrao"
}

