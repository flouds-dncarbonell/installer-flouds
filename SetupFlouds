## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## EXECUÇÃO COM PROGRESSO
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

passo_atual=0
passos_total=0

## Executa uma etapa técnica mostrando uma linha comum na tela e mandando toda
## a saída detalhada para o log. Em --verbose a saída também aparece na tela.
executar_passo() {
    local rotulo="$1"
    shift
    local resultado

    passo_atual=$((passo_atual + 1))
    log_tecnico "passo ${passo_atual}/${passos_total}: ${rotulo}"

    printf ' %b●%b %s...' "$amarelo" "$reset" "$rotulo"

    if [ "$modo_verbose" = true ]; then
        echo ""
        "$@" 2>&1 | tee -a "$log_file"
        resultado=${PIPESTATUS[0]}
    else
        "$@" >> "$log_file" 2>&1
        resultado=$?
    fi

    if [ "$resultado" -eq 0 ]; then
        printf '\r %b✔%b %s                    \n' "$verde" "$reset" "$rotulo"
        log_tecnico "concluído: ${rotulo}"
    else
        printf '\r %b✖%b %s                    \n' "$vermelho" "$reset" "$rotulo"
        log_tecnico "falhou: ${rotulo} (código ${resultado})"
    fi

    return "$resultado"
}

## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## VERIFICAÇÕES OBJETIVAS
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## Verdadeiro quando todos os serviços da stack têm as réplicas esperadas.
stack_saudavel() {
    local stack="$1"
    local pendentes
    local servicos

    servicos=$(docker stack services "$stack" --format "{{.Name}}" 2>/dev/null)
    [ -n "$servicos" ] || return 1

    pendentes=$(docker stack services "$stack" --format "{{.Replicas}}" 2>/dev/null | awk '{
        split($1, replicas, "/")
        if (replicas[1] != replicas[2] || replicas[2] == "0") print
    }')
    [ -z "$pendentes" ]
}

## Verdadeiro quando a stack acumula tarefas falhando: sinal de serviço em
## ciclo de reinício, que não pode ser confundido com uma stack saudável.
stack_em_reinicio() {
    local stack="$1"
    local servico
    local falhas

    for servico in $(docker stack services "$stack" --format "{{.Name}}" 2>/dev/null); do
        falhas=$(docker service ps "$servico" --format "{{.CurrentState}}" 2>/dev/null \
            | head -5 | grep -ciE "failed|rejected")
        [ "${falhas:-0}" -ge 3 ] && return 0
    done
    return 1
}

## Responde por HTTPS, aceitando o certificado que estiver lá.
url_responde() {
    local dominio="$1"
    local codigo

    codigo=$(curl -k -sS -L -o /dev/null --max-time 15 -w "%{http_code}" \
        "https://${dominio}" 2>/dev/null || true)
    log_tecnico "resposta de https://${dominio}: ${codigo:-sem resposta}"
    [[ "$codigo" =~ ^2[0-9][0-9]$ ]]
}

## Certificado emitido e confiável: aqui o -k é intencionalmente omitido.
certificado_valido() {
    local dominio="$1"

    curl -sS -L -o /dev/null --max-time 15 "https://${dominio}" >/dev/null 2>&1
}

## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## ETAPA 1 DE 5 — VERIFICAR O SERVIDOR
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

etapa1_verificar_servidor() {
    local sistema
    local vcpu
    local ram_kb
    local ram
    local portas_ocupadas=""
    local atencao=false
    local escolha
    local faltando
    local ferramenta

    while true; do
        titulo_etapa 1 "Verificando o servidor"

        sistema=$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")
        vcpu=$(nproc 2>/dev/null || echo 1)
        ram_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
        ram_kb=${ram_kb:-0}
        ram=$(awk -v kb="$ram_kb" 'BEGIN { printf "%.1f", kb / 1000000 }')
        atencao=false

        item_ok "$(rotulo_valor "Sistema operacional" "${sistema:-Linux}")"
        item_ok "$(rotulo_valor "Acesso de administrador" "ok")"

        if [ "$vcpu" -lt 1 ] || [ "$ram_kb" -lt 1900000 ]; then
            item_atencao "$(rotulo_valor "Recursos" "${vcpu} vCPU e ${ram} GB (recomendado: 1 vCPU e 2 GB)")"
            atencao=true
        else
            item_ok "$(rotulo_valor "Recursos" "${vcpu} vCPU e ${ram} GB")"
        fi

        ## O bootstrap Setup instala essas dependências. Quem executa o
        ## SetupFlouds direto pode não tê-las, e sem elas nada funciona.
        faltando=""
        for ferramenta in curl jq; do
            command -v "$ferramenta" >/dev/null 2>&1 || faltando="$faltando $ferramenta"
        done
        if [ -n "$faltando" ]; then
            item_falha "$(rotulo_valor "Programas necessários" "faltando:$faltando")"
            atencao=true
        else
            item_ok "$(rotulo_valor "Programas necessários" "disponíveis")"
        fi

        if command -v docker >/dev/null 2>&1; then
            item_ok "$(rotulo_valor "Docker" "instalado")"
        else
            item_pendente "$(rotulo_valor "Docker" "será instalado")"
        fi

        if [ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; then
            item_ok "$(rotulo_valor "Modo cluster" "ativo")"
        else
            item_pendente "$(rotulo_valor "Modo cluster" "será configurado")"
        fi

        ## O modo local não usa Traefik: as portas que importam são as que o
        ## FZAP e o painel publicam direto no host.
        portas_ocupadas=$(portas_em_uso)
        if [ "$modo_local" = true ]; then
            if [ -n "$portas_ocupadas" ]; then
                item_falha "$(rotulo_valor "Portas ${porta_fzap_local} e ${porta_painel_local}" "em uso por outro programa:$portas_ocupadas")"
                atencao=true
            else
                item_ok "$(rotulo_valor "Portas ${porta_fzap_local} e ${porta_painel_local}" "disponíveis")"
            fi
        elif [ -n "$portas_ocupadas" ] && ! _tem_traefik; then
            item_falha "$(rotulo_valor "Portas 80 e 443" "em uso por outro programa:$portas_ocupadas")"
            atencao=true
        else
            item_ok "$(rotulo_valor "Portas 80 e 443" "disponíveis")"
        fi

        if [ "$modo_local" = true ]; then
            item_pendente "$(rotulo_valor "Preparação do servidor" "modo local, sem HTTPS")"
        elif _tem_traefik && _tem_portainer; then
            item_ok "$(rotulo_valor "Preparação do servidor" "já feita")"
        elif _tem_traefik || _tem_portainer; then
            item_atencao "$(rotulo_valor "Preparação do servidor" "incompleta")"
            atencao=true
        else
            item_pendente "$(rotulo_valor "Preparação do servidor" "será feita agora")"
        fi

        echo ""

        if [ "$atencao" = false ]; then
            linha_fina
            ler_entrada -p " Pressione ENTER para continuar, ou 0 para sair: " escolha
            [ "$escolha" = "0" ] && return 1
            estado_gravar "verificado_servidor"
            return 0
        fi

        if [ -n "$portas_ocupadas" ] && { [ "$modo_local" = true ] || ! _tem_traefik; }; then
            if [ "$modo_local" = true ]; then
                echo -e "$bege As portas ${porta_fzap_local} e ${porta_painel_local} são usadas para publicar o FZAP e o$reset"
                echo -e "$bege painel neste computador. Elas precisam estar livres.$reset"
            else
                echo -e "$bege As portas 80 e 443 são usadas para publicar o FZAP na internet e$reset"
                echo -e "$bege para emitir o certificado HTTPS. Elas precisam estar livres.$reset"
            fi
            echo ""
            echo -e " Programa que as ocupa hoje:"
            ss -ltnpH 2>/dev/null \
                | awk -v p1="$(porta_publicada_fzap)" -v p2="$(porta_publicada_painel)" \
                    '$4 ~ "(^|:)(" p1 "|" p2 ")$" {print "   " $4 "  " $6}' | head -5
            echo ""
        fi

        if [ -n "$faltando" ]; then
            echo -e "$bege Instale os programas que faltam e execute o instalador novamente:$reset"
            echo ""
            echo -e "   apt-get install -y$faltando"
            echo ""
        fi

        if _tem_traefik && ! _tem_portainer || ! _tem_traefik && _tem_portainer; then
            echo -e "$bege A preparação anterior deste servidor ficou pela metade. As$reset"
            echo -e "$bege configurações avançadas permitem reparar apenas a parte que falta.$reset"
            echo ""
        fi

        linha_fina
        echo -e " $amarelo[1]$reset Verificar novamente — recomendado"
        echo -e " $amarelo[2]$reset Continuar mesmo assim"
        echo -e " $amarelo[0]$reset Sair"
        echo ""
        ler_entrada -p " Escolha: " escolha
        case "$escolha" in
            1) ;;
            2) estado_gravar "verificado_servidor"; return 0 ;;
            0) return 1 ;;
            *) ;;
        esac
    done
}

## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //
## ETAPA 2 DE 5 — ENDEREÇOS
## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## // ## //

## O domínio do painel é derivado do domínio-base, exceto quando já existe uma
## infraestrutura registrada: nesse caso o endereço dela é preservado.
derivar_enderecos() {
    local painel_existente=""

    url_fzap="fzap.${dominio_base}"

    if [ -f "$dados_portainer_file" ]; then
        painel_existente=$(ler_campo_arquivo "$dados_portainer_file" "Dominio do portainer: ")
    fi

    if [ -n "$painel_existente" ] && eh_dominio_valido "$painel_existente"; then
        url_portainer="$painel_existente"
        painel_reaproveitado=true
    else
        url_portainer="painel.${dominio_base}"
        painel_reaproveitado=false
    fi
}

## Endereços informados um a um. É o caminho de quem já tem os subdomínios
## apontados e não segue a convenção fzap./painel., por exemplo
## app.empresa.com.br. Aqui não existe domínio-base: tentar deduzi-lo a
## partir do host erraria com sufixos como com.br.
perguntar_enderecos_explicitos() {
    local painel_existente=""
    local resposta

    dominio_base=""

    while true; do
        echo -e "$branco Endereço do FZAP$reset"
        echo -e "$bege Exemplo: fzap.empresa.com.br$reset"
        ler_entrada -p " > " resposta
        resposta=$(normalizar_dominio "$resposta")
        if eh_dominio_valido "$resposta"; then
            url_fzap="$resposta"
            break
        fi
        item_falha "Endereço inválido. Informe apenas o host, sem http:// e sem barras."
    done
    echo ""

    if [ -f "$dados_portainer_file" ]; then
        painel_existente=$(ler_campo_arquivo "$dados_portainer_file" "Dominio do portainer: ")
    fi

    ## O endereço de um painel já instalado não é perguntado: mudá-lo exigiria
    ## reinstalar o painel, o que não faz parte da jornada principal.
    if [ -n "$painel_existente" ] && eh_dominio_valido "$painel_existente"; then
        url_portainer="$painel_existente"
        painel_reaproveitado=true
        item_ok "Painel técnico já instalado em $url_portainer"
        echo ""
        return 0
    fi

    painel_reaproveitado=false
    while true; do
        echo -e "$branco Endereço do painel técnico$reset"
        echo -e "$bege Exemplo: painel.empresa.com.br$reset"
        ler_entrada -p " > " resposta
        resposta=$(normalizar_dominio "$resposta")
        if ! eh_dominio_valido "$resposta"; then
            item_falha "Endereço inválido. Informe apenas o host, sem http:// e sem barras."
            continue
        fi
        if [ "$resposta" = "$url_fzap" ]; then
            item_falha "O painel técnico precisa de um endereço diferente do FZAP."
            continue
        fi
        url_portainer="$resposta"
        break
    done
    echo ""
}

## Detecta se este computador tem cara de máquina local em vez de servidor
## exposto. Nenhum sinal isolado é conclusivo, então o resultado só muda a
## recomendação da tela: quem quiser um domínio continua podendo escolhê-lo.
##   0 = provavelmente local
##   1 = provavelmente um servidor com IP público
motivo_ambiente_local=""
parece_ambiente_local() {
    local ip_local ip_externo

    motivo_ambiente_local=""

    ## WSL e containers de desktop nunca recebem tráfego da internet.
    if grep -qi "microsoft" /proc/version 2>/dev/null; then
        motivo_ambiente_local="este sistema roda no WSL"
        return 0
    fi

    ip_externo=$(ip_publico)
    ip_local=$(ip_para_anunciar)

    ## Sem saída para a internet não há como emitir certificado.
    if [ -z "$ip_externo" ]; then
        motivo_ambiente_local="este computador não tem IP público acessível"
        return 0
    fi

    ## IP local privado e diferente do IP visto de fora significa NAT: o
    ## endereço público pertence ao roteador, não a esta máquina.
    if [ -n "$ip_local" ] && [ "$ip_local" != "$ip_externo" ] \
        && [[ "$ip_local" =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.) ]]; then
        motivo_ambiente_local="este computador está atrás de NAT (IP local $ip_local)"
        return 0
    fi

    return 1
}

## Numa instalação local não há endereço a escolher nem DNS a verificar: os
## valores existem apenas para nomear as stacks e o arquivo de credenciais.
configurar_enderecos_locais() {
    dominio_base=""
    url_fzap="localhost"
    url_portainer="localhost"
    painel_reaproveitado=false
    log_tecnico "modo local ativado (fzap:${porta_fzap_local} painel:${porta_painel_local})"
}

## Quem tem um domínio livre aceita as sugestões; quem já apontou subdomínios
## informa cada endereço.
escolher_modo_enderecos() {
    local escolha
    local local_provavel=false

    parece_ambiente_local && local_provavel=true

    while true; do
        echo -e "$branco Como você quer definir os endereços?$reset"
        echo ""

        ## A recomendação segue o ambiente detectado; as opções são as mesmas.
        if [ "$local_provavel" = true ]; then
            echo -e "$bege Detectamos que ${motivo_ambiente_local}, então um domínio$reset"
            echo -e "$bege público provavelmente não vai funcionar aqui.$reset"
            echo ""
            echo -e " $amarelo[1]$reset Tenho um domínio e quero as sugestões"
            echo -e " $amarelo[2]$reset Já tenho endereços apontados para este servidor"
            echo -e " $amarelo[3]$reset Instalar localmente, sem domínio — recomendado"
            echo -e "$bege     Acesso por http://localhost:${porta_fzap_local}, sem HTTPS.$reset"
        else
            echo -e " $amarelo[1]$reset Tenho um domínio e quero as sugestões — recomendado"
            echo -e "$bege     O instalador usa fzap. para o FZAP e painel. para o painel.$reset"
            echo -e " $amarelo[2]$reset Já tenho endereços apontados para este servidor"
            echo -e "$bege     Você informa cada endereço, com o nome que quiser.$reset"
            echo -e " $amarelo[3]$reset Instalar localmente, sem domínio"
            echo -e "$bege     Acesso por http://localhost:${porta_fzap_local}, sem HTTPS. Para testes.$reset"
        fi

        echo ""
        echo -e " $amarelo[0]$reset Sair"
        echo ""
        ler_entrada -p " Escolha: " escolha
        echo ""

        ## Enter aceita a recomendação, seja ela qual for.
        if [ -z "$escolha" ] && [ "$local_provavel" = true ]; then
            escolha=3
        fi

        case "$escolha" in
            ""|1)
                modo_local=false
                perguntar_dominio_base || return 1
                derivar_enderecos
                return 0
                ;;
            2)
                modo_local=false
                perguntar_enderecos_explicitos
                return 0
                ;;
            3)
                modo_local=true
                configurar_enderecos_locais
                return 0
                ;;
            0) return 1 ;;
            *) titulo_etapa 2 "Endereços" ;;
        esac
    done
}

etapa2_enderecos() {
    local forcar="${1:-false}"
    local escolha
    local resultado_fzap
    local resultado_painel
    local ip_vps

    if [ "$forcar" = true ] || [ -z "$url_fzap" ]; then
        painel_reaproveitado=false
        if [ "$modo_local" = true ] && [ "$forcar" != true ]; then
            ## --local já respondeu a pergunta desta etapa.
            configurar_enderecos_locais
        else
            titulo_etapa 2 "Endereços"
            escolher_modo_enderecos || return 1
        fi
    fi

    ## O modo local não depende de DNS: mostra o que será publicado e segue.
    if [ "$modo_local" = true ]; then
        titulo_etapa 2 "Endereços"
        item_ok "FZAP            $(url_fzap_completa)"
        item_ok "Painel técnico  $(url_painel_completa)"
        echo ""
        echo -e "$bege Instalação local: sem domínio, sem HTTPS e sem certificado. O acesso$reset"
        echo -e "$bege é só a partir deste computador.$reset"
        echo ""
        estado_gravar "dns_ok"
        linha_fina
        ler_entrada -p " Pressione ENTER para continuar: " escolha
        return 0
    fi

    while true; do
        titulo_etapa 2 "Endereços"

        ip_vps=$(ip_publico)

        checar_dns_host "$url_fzap"
        resultado_fzap=$?
        case "$resultado_fzap" in
            0) item_ok "FZAP            $url_fzap" ;;
            1) item_falha "FZAP            $url_fzap — ainda não aponta para cá" ;;
            2) item_atencao "FZAP            $url_fzap — aponta para $dns_ips_encontrados" ;;
            *) item_atencao "FZAP            $url_fzap — não foi possível confirmar" ;;
        esac

        checar_dns_host "$url_portainer"
        resultado_painel=$?
        case "$resultado_painel" in
            0) item_ok "Painel técnico  $url_portainer" ;;
            1) item_falha "Painel técnico  $url_portainer — ainda não aponta para cá" ;;
            2) item_atencao "Painel técnico  $url_portainer — aponta para $dns_ips_encontrados" ;;
            *) item_atencao "Painel técnico  $url_portainer — não foi possível confirmar" ;;
        esac

        echo ""
        [ -n "$ip_vps" ] && echo -e "$bege O IP deste servidor é ${ip_vps}.$reset" && echo ""

        if [ "$resultado_fzap" -eq 0 ] && [ "$resultado_painel" -eq 0 ]; then
            estado_gravar "dns_ok"
            linha_fina
            ler_entrada -p " Pressione ENTER para continuar: " escolha
            return 0
        fi

        [ "$resultado_fzap" -eq 1 ] && mostrar_registro_dns "$url_fzap" "$dominio_base"
        [ "$resultado_painel" -eq 1 ] && mostrar_registro_dns "$url_portainer" "$dominio_base"

        echo -e "$bege Você pode instalar agora e criar os registros depois: os endereços$reset"
        echo -e "$bege passam a funcionar sozinhos quando o DNS estiver pronto. O HTTPS só$reset"
        echo -e "$bege é ativado depois disso.$reset"
        echo ""

        linha_fina
        echo -e " $amarelo[1]$reset Verificar novamente — recomendado"
        echo -e " $amarelo[2]$reset Instalar agora e configurar o DNS depois"
        echo -e " $amarelo[3]$reset Alterar os endereços"
        echo -e " $amarelo[0]$reset Sair"
        echo ""
        ler_entrada -p " Escolha: " escolha

        case "$escolha" in
            1) ;;
            2)
                log_tecnico "usuário escolheu instalar antes de o DNS estar pronto"
                estado_gravar "dns_ok"
                return 0
                ;;
            3)
                painel_reaproveitado=false
                titulo_etapa 2 "Endereços"
                escolher_modo_enderecos || return 1
                ;;
            0) return 1 ;;
            *) ;;
        esac
    done
}

